# Release archives (`git archive`, and the "Source code" zip/tar.gz that GitHub
# attaches to every release) contain only what the web server needs to serve,
# plus the license files.
# Everything below is repository tooling, documentation or source material.

# Dotfiles and dot-directories (.github, .githooks, .vscode, .editorconfig, …)
.*                      export-ignore

# Documentation (not served)
README.md               export-ignore

# Tooling configuration
lighthouserc.json       export-ignore
eslint.config.mjs       export-ignore

# Sources that are rendered into served files
img/og-image.svg        export-ignore
favicons/maskable.svg   export-ignore
